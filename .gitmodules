[submodule "Candle/vendor/imgui"]
	path = Candle/vendor/imgui/imgui
	url = https://github.com/ocornut/imgui.git
[submodule "Candle/vendor/SDL3"]
	path = Candle/vendor/SDL3/SDL3
	url = https://github.com/libsdl-org/SDL.git
[submodule "Candle/vendor/glm"]
	path = Candle/vendor/glm
	url = https://github.com/g-truc/glm.git
[submodule "Candle/vendor/tracy/tracy"]
	path = Candle/vendor/tracy/tracy
	url = https://github.com/wolfpld/tracy.git
[submodule "Candle/vendor/VMA/VMA"]
	path = Candle/vendor/VMA/VMA
	url = https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
[submodule "Candle/vendor/stb/stb"]
	path = Candle/vendor/stb/stb
	url = https://github.com/nothings/stb.git
[submodule "Candle/vendor/ktx/ktx"]
	path = Candle/vendor/ktx/ktx
	url = https://github.com/KhronosGroup/KTX-Software.git
	shallow = true
